{
  "name": "never-again",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.functions.json && vite build",
    "d1:migrate:local": "wrangler d1 migrations apply never-again-db --local",
    "d1:users:local": "wrangler d1 execute never-again-db --local --command \"SELECT id, email, assistant_status, backboard_assistant_id FROM users;\"",
    "lint": "eslint .",
    "pages:dev": "wrangler pages dev dist --port 8788",
    "preview": "vite preview"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.17.0",
    "jose": "^6.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260523.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "wrangler": "^4.94.0"
  }
}
